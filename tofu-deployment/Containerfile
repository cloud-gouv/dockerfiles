FROM ghcr.io/opentofu/opentofu:v1.11-minimal@sha256:11d0bbe4d7c6cf7ce5f3b516908db4eaa0f3561dd5b444cab444c72471e541a5 AS tofu

FROM docker.io/python:3-15-slim-trixie@sha256:f48fda6d59b2b3437781d1c3ccf4aa0e26ae871de3cdd758b49ab45ee7291619

